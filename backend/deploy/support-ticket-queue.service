[Unit]
Description=Support ticket queue
After=network.target

[Service]
Type=exec
User=deploy
WorkingDirectory=/srv/devlab/current
Environment=TICKET_DB_PATH=/srv/devlab/data/tickets.sqlite3
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/devlab/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
